<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="鲸娘钱包" Width="284" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" FontFamily="Microsoft YaHei UI" UseLayoutRounding="True">
<Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#546D85"/><Setter Property="FontSize" Value="11"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Padding" Value="12,8"/><Setter Property="Background" Value="#70FFFFFF"/><Setter Property="BorderBrush" Value="#B0FFFFFF"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#E5FFFFFF"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.65"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#304C67"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
     <ContentPresenter VerticalAlignment="Center"/>
     <Border x:Name="Track" Grid.Column="1" Height="21" Background="#CFDDE7" CornerRadius="11" VerticalAlignment="Center">
      <Ellipse x:Name="Knob" Fill="White" Width="15" Height="15" HorizontalAlignment="Left" Margin="3,0"/>
     </Border>
    </Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True">
     <Setter TargetName="Track" Property="Background" Value="#85B9D8"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
    </Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="9,7"/><Setter Property="Background" Value="#AFFFFFFF"/><Setter Property="BorderBrush" Value="#D5E4EC"/><Setter Property="Foreground" Value="#304C67"/><Setter Property="FontSize" Value="11"/></Style>
  <Style x:Key="GlassSliderButton" TargetType="RepeatButton">
   <Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Slider">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Height" Value="24"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
    <Grid><Border Height="4" Margin="8,0" CornerRadius="2" Background="#C6DDEC"/>
     <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
      <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Style="{StaticResource GlassSliderButton}" Background="#85B9D8"/></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb Width="16" Height="16"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border CornerRadius="8" Background="White" BorderBrush="#A9CADE" BorderThickness="1"><Border.Effect><DropShadowEffect Color="#7BA4C1" Opacity="0.2" BlurRadius="4" ShadowDepth="1"/></Border.Effect></Border></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Style="{StaticResource GlassSliderButton}" Background="Transparent"/></Track.IncreaseRepeatButton>
     </Track>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ToolTip"><Setter Property="Background" Value="#F4F7FCFF"/><Setter Property="Foreground" Value="#58758C"/><Setter Property="FontSize" Value="10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip"><Border Padding="11,8" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="#D7E7F2" BorderThickness="1"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ContextMenu">
   <Setter Property="Background" Value="#F0EDF6FE"/><Setter Property="BorderBrush" Value="#EDFFFFFF"/><Setter Property="FontFamily" Value="Microsoft YaHei UI"/><Setter Property="FontSize" Value="11"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
    <Border Margin="8" Padding="6" CornerRadius="15" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
     <Border.Effect><DropShadowEffect Color="#42688C" Opacity="0.15" BlurRadius="12" ShadowDepth="2"/></Border.Effect><StackPanel IsItemsHost="True"/>
    </Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="MenuItem">
   <Setter Property="Foreground" Value="#55748D"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
    <Grid><Border x:Name="ItemBg" CornerRadius="9" Background="Transparent" Padding="10,8" MinWidth="154">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="17"/><ColumnDefinition/><ColumnDefinition Width="14"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="CheckMark" Text="✓" Foreground="#74A9C9" Visibility="Hidden"/>
      <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"/>
      <TextBlock x:Name="Arrow" Grid.Column="2" Text="›" FontSize="15" Foreground="#9BB4CA" Visibility="Collapsed" HorizontalAlignment="Right"/>
     </Grid>
    </Border>
    <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="0" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
     <Border Margin="5" Padding="5" CornerRadius="13" Background="#F5EDF6FE" BorderBrush="#EDFFFFFF" BorderThickness="1"><StackPanel IsItemsHost="True"/></Border>
    </Popup></Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBg" Property="Background" Value="#D5E9F9"/></Trigger>
     <Trigger Property="HasItems" Value="True"><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Separator"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Margin="12,5" Background="#C9DEEE"/></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
<Grid Margin="9,5,9,9" MinHeight="70">
 <Border x:Name="Shell" CornerRadius="19" BorderThickness="1" Margin="24,14,0,4" MinHeight="51" Cursor="SizeAll" ToolTip="拖动移动 · 右键管理账户">
  <Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1"><GradientStop Color="#F0FFFFFF"/><GradientStop Color="#A7DCF6" Offset="0.52"/><GradientStop Color="#80FFFFFF" Offset="1"/></LinearGradientBrush></Border.BorderBrush>
  <Border.ContextMenu><ContextMenu><MenuItem x:Name="MenuManage" Header="账户与外观"/><MenuItem x:Name="MenuPortraits" Header="切换立绘"/><MenuItem x:Name="MenuRefresh" Header="扫描账户 / 刷新"/><MenuItem x:Name="MenuPin" Header="始终置顶" IsCheckable="True"/><Separator/><MenuItem x:Name="MenuClose" Header="收起小挂件"/></ContextMenu></Border.ContextMenu>
  <Border.Effect><DropShadowEffect Color="#39769B" Opacity="0.16" BlurRadius="13" ShadowDepth="3"/></Border.Effect>
  <Grid>
   <Grid x:Name="GlassSurface">
   <Border CornerRadius="18"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0.65,1"><GradientStop Color="#FFF6FCFF"/><GradientStop Color="#FFCCEAFF" Offset="0.65"/><GradientStop Color="#FFDEECFF" Offset="1"/></LinearGradientBrush></Border.Background></Border>
   <Border x:Name="Backdrop" CornerRadius="18"/>
   <Border x:Name="Tint" CornerRadius="18"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0.65,1"><GradientStop Color="#C5F6FCFF"/><GradientStop Color="#9CCCEAFF" Offset="0.65"/><GradientStop Color="#B8DEECFF" Offset="1"/></LinearGradientBrush></Border.Background></Border>
   <Border Margin="1" CornerRadius="17" BorderThickness="0.7" BorderBrush="#70FFFFFF" IsHitTestVisible="False"/>
   <Border CornerRadius="18" IsHitTestVisible="False"><Border.Background><RadialGradientBrush Center="0.12,0" GradientOrigin="0.12,0" RadiusX="0.8" RadiusY="1.2"><GradientStop Color="#75FFFFFF"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush></Border.Background></Border>
   <Border Height="1" Margin="19,2,19,0" VerticalAlignment="Top" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#00FFFFFF"/><GradientStop Color="#EFFFFFFF" Offset="0.5"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Border.Background></Border>
   </Grid>
   <StackPanel Margin="43,5,14,5" VerticalAlignment="Center"><StackPanel x:Name="Dashboard"><StackPanel x:Name="Cards"/><TextBlock x:Name="EmptyState" Text="右键选择显示的账户" FontSize="10" Foreground="#6E9BB5" Margin="0,9" Visibility="Collapsed"/></StackPanel></StackPanel>
  </Grid>
 </Border>
 <Border x:Name="MascotGlow" Width="56" Height="52" CornerRadius="25" Background="#FFDEF3FF" BorderBrush="#83FFFFFF" BorderThickness="0.7" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3,15,0,0" IsHitTestVisible="False"/>
 <Image x:Name="Mascot" Width="68" Height="64" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-1,0,0,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Cursor="Hand" ToolTip="鲸蓝陪你一起攒灵感～">
  <Image.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="White" Offset="0"/><GradientStop Color="White" Offset="0.83"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Image.OpacityMask>
 </Image>
 <StackPanel Visibility="Collapsed"><Border x:Name="DragHeader"/><TextBlock x:Name="SyncText"/><TextBlock x:Name="AccountCount"/><Button x:Name="RefreshButton"/><Button x:Name="ManageButton"/><Button x:Name="PinButton"/><Button x:Name="CloseButton"/></StackPanel>
 <Popup x:Name="SettingsPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=Shell}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="4">
  <Border Width="324" Margin="10" CornerRadius="22" BorderBrush="#EDFFFFFF" BorderThickness="1" Padding="17,16">
   <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0.7,1"><GradientStop Color="#F5F4FAFF"/><GradientStop Color="#EBE1F0FC" Offset="0.65"/><GradientStop Color="#F2EBEEFF" Offset="1"/></LinearGradientBrush></Border.Background>
   <Border.Effect><DropShadowEffect Color="#456E91" Opacity="0.17" BlurRadius="17" ShadowDepth="3"/></Border.Effect>
   <StackPanel x:Name="Settings" Visibility="Collapsed">
    <Grid Margin="2,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="账户与外观" FontSize="14" FontWeight="SemiBold" Foreground="#466982"/><TextBlock x:Name="DiscoveryStatus" Text="自动连接本机账户" FontSize="9" Foreground="#91A7BA" Margin="0,5,0,0"/></StackPanel>
     <Button x:Name="BackButton" Grid.Column="1" Content="×" FontFamily="Segoe UI" FontSize="18" Padding="8,1" VerticalAlignment="Top" Background="#80FFFFFF" ToolTip="关闭设置"/>
    </Grid>
    <ScrollViewer MaxHeight="274" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Switches"/></ScrollViewer>
    <TextBlock Text="选择在挂件里显示的账户，关闭后可随时打开。" FontSize="9" Foreground="#8DA3B7" Margin="3,1,0,14"/>
    <Grid Margin="3,0,2,10"><TextBlock Text="今天的鲸娘" FontSize="10" Foreground="#6988A1"/><TextBlock Text="轻点换装" FontSize="9" Foreground="#A2B4C5" HorizontalAlignment="Right"/></Grid>
    <UniformGrid x:Name="PortraitOptions" Columns="3" Margin="0,0,0,11"/>
    <Border CornerRadius="12" Background="#55FFFFFF" Padding="11,9,11,6" Margin="0,0,0,6">
     <StackPanel>
      <Grid Margin="1,0,1,3"><TextBlock Text="玻璃透明度" Foreground="#6D8A9F" FontSize="10"/><TextBlock x:Name="TransparencyValue" Foreground="#7FA8C2" FontSize="10" HorizontalAlignment="Right"/></Grid>
      <Slider x:Name="TransparencySlider" Minimum="0" Maximum="90" Value="25" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" SmallChange="1" LargeChange="10" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="0" ToolTip="0% 完全不透明，向右逐渐透明；文字和鲸娘保持清晰"/>
      <Grid Margin="1,0,1,0"><TextBlock Text="不透明" FontSize="8" Foreground="#A1B4C3"/><TextBlock Text="通透" FontSize="8" Foreground="#A1B4C3" HorizontalAlignment="Right"/></Grid>
     </StackPanel>
    </Border>
    <CheckBox x:Name="PinToggle" Margin="3,0,3,5"><TextBlock Text="始终浮在最上面" Foreground="#6D8A9F" FontSize="10"/></CheckBox>
    <Button x:Name="ScanButton" Content="↻  重新扫描" Padding="10,9" Foreground="#5E8BA8" Background="#8FFFFFFF"/>
    <TextBlock x:Name="SaveHint" FontSize="9" TextAlignment="Center" TextWrapping="Wrap" Foreground="#9BAFBE" Margin="2,10,2,0"/>
   </StackPanel>
  </Border>
 </Popup>
</Grid>
</Window>
